# Flask Environment Configuration
# Set to 'production' or 'development' to explicitly set environment
# If not set, environment will be auto-detected based on other variables
FLASK_ENV=development

# Alternative: Use FLASK_DEBUG to infer environment
# FLASK_DEBUG=true  # Sets environment to development
# FLASK_DEBUG=false # Sets environment to production

# Flask Secret Key (REQUIRED for production)
SECRET_KEY=your_secret_key_here

# Development Database Configuration (with defaults)
LOCAL_MYSQL_HOST=localhost
LOCAL_MYSQL_PORT=3306
LOCAL_MYSQL_USER=root
LOCAL_MYSQL_PASSWORD=your_password_here
LOCAL_MYSQL_DATABASE=kidsathome

# Production Database Configuration (REQUIRED for production)
# These variables are automatically detected to set environment to production
PRODUCTION_DB_HOST=your_production_db_host
PRODUCTION_DB_PORT=3306
PRODUCTION_DB_USER=your_production_db_user
PRODUCTION_DB_PASSWORD=your_production_db_password
PRODUCTION_DB_NAME=your_production_db_name

# Legacy Database Configuration (for backward compatibility)
# These are used by the old get_db_connection() function
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=kidsathome
DB_PORT=3306

# OpenAI Configuration (if using)
OPENAI_API_KEY=your_openai_api_key_here
